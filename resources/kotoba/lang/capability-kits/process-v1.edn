{:kotoba.capability-kit/name :process
 :kotoba.capability-kit/version 1
 :capability {:name :process/spawn :id 20}
 :semantics {:operation :spawn-await
             :ambient-path false
             :command-authority :host-basename-allowlist
             :execution :synchronous-reference}
 :limits {:argv 32 :arg-bytes 4096 :stdout-bytes 65536 :timeout-ms [1 600000]}
 :request
 [:record :kotoba.process/spawn-request
  [[:argv [:vector :string]]
   [:max-stdout-bytes :i64]
   [:timeout-ms :i64]]]
 :result
 [:variant :kotoba.process/reply
  [[:ok [:record :kotoba.process/spawn-result
          [[:exit :i64] [:stdout :string] [:stderr :string]]]]
   [:error [:record :kotoba.process/error
             [[:code :keyword] [:message :string]]]]]]
 :transports
 {:echo :test
  :os-spawn-jvm :landed
  :os-spawn-cljs :landed}
 :qualification {:reference :implemented
                 :dual-runtime-os-transport :landed
                 :wasm-aot :partial
                 :native-aot :pending
                 :jit :pending
                 :signed-content-addressed-package :ready
                 :notes "ADR 0168 hand WAT bounds + Component; ADR 0172 compiler-AOT re-emit (process-spawn-bounds-v1, i64 ABI). OS spawn host-injected; full request/result EDN codec AOT still open (wasm-aot :partial)."}}
