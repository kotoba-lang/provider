(ns kotoba.http.headers-edn-set-fold
  ;; T8.3 ADR 0233: full headers EDN vector from kit-shaped set-of-header-records
  ;; via typed-set-nth fold (compiler ADR 0194 / kir ADR 0024).
  ;; Complements ADR 0231 (headers-n skeleton only). Name uniqueness via
  ;; parallel :names set. W4 recursive nested EDN / wasm-aot still open.
  (:schemas {:hdr/pair [:record :hdr/pair
                        [[:name :string] [:value :string]]]
              :hdr/bag [:record :hdr/bag
                        [[:headers [:set [:ref :hdr/pair]]]
                         [:names [:set :string]]
                         [:code :i64]]]})
  (:export [http_hdr_begin
            http_hdr_add
            http_hdr_code
            http_hdr_count
            http_hdr_edn
            main]))

(defn- has-forbidden [s :string] :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n) 0
        (let [c (string-code-point-at s i)]
          (if (= c 34) 1
            (if (= c 92) 1 (recur (+ i 1)))))))))

(defn- header-map-edn [h [:ref :hdr/pair]] :string
  (string-concat "{:name \""
                 (string-concat (record-get h :name)
                                (string-concat "\" :value \""
                                               (string-concat (record-get h :value) "\"}")))))

(defn- fold-headers-edn
  [headers [:set [:ref :hdr/pair]] n :i64 i :i64 acc :string]
  :string
  (if (>= i n)
    acc
    (let [h (typed-set-nth [:set [:ref :hdr/pair]] headers i)
          piece (header-map-edn h)
          acc2 (if (string=? acc "[]")
                 (string-concat "[" (string-concat piece "]"))
                 (string-concat
                  (string-substring acc 0 (- (string-length acc) 1))
                  (string-concat " " (string-concat piece "]"))))]
      (fold-headers-edn headers n (+ i 1) acc2))))

(defn http_hdr_begin []
  [:ref :hdr/bag]
  (record-new [:ref :hdr/bag]
              (typed-set-new [:set [:ref :hdr/pair]])
              (typed-set-new [:set :string])
              0))

(defn http_hdr_code [st [:ref :hdr/bag]] :i64 (record-get st :code))

(defn http_hdr_count [st [:ref :hdr/bag]] :i64
  (typed-set-count [:set [:ref :hdr/pair]] (record-get st :headers)))

(defn http_hdr_add
  [st [:ref :hdr/bag] name :string value :string]
  [:ref :hdr/bag]
  (let [headers (record-get st :headers)
        names (record-get st :names)
        code (record-get st :code)]
    (if (not= code 0)
      (record-new [:ref :hdr/bag] headers names code)
      (if (= (string-length name) 0)
        (record-new [:ref :hdr/bag] headers names -1)
        (if (or (= (has-forbidden name) 1) (= (has-forbidden value) 1))
          (record-new [:ref :hdr/bag] headers names -3)
          (if (typed-set-contains [:set :string] names name)
            (record-new [:ref :hdr/bag] headers names -9)
            (if (>= (typed-set-count [:set [:ref :hdr/pair]] headers) 32)
              (record-new [:ref :hdr/bag] headers names -4)
              (let [h (record-new [:ref :hdr/pair] name value)
                    headers2 (typed-set-conj [:set [:ref :hdr/pair]] headers h)
                    names2 (typed-set-conj [:set :string] names name)]
                (record-new [:ref :hdr/bag] headers2 names2 0)))))))))

(defn http_hdr_edn
  [st [:ref :hdr/bag]]
  :string
  (let [code (record-get st :code)
        headers (record-get st :headers)
        n (typed-set-count [:set [:ref :hdr/pair]] headers)]
    (if (not= code 0)
      ""
      (fold-headers-edn headers n 0 "[]"))))

(defn main [] :i64
  (let [s0 (http_hdr_begin)
        s1 (http_hdr_add s0 "Host" "ex.com")
        s2 (http_hdr_add s1 "Accept" "*/*")
        e (http_hdr_edn s2)
        s3 (http_hdr_add s2 "Host" "other")
        c (http_hdr_code s3)
        n (http_hdr_count s2)
        ok (if (> (string-length e) 10)
             (if (string-contains? e "Accept")
               (if (string-contains? e "Host") 1 0)
               0)
             0)]
    (if (= c -9)
      (if (= n 2)
        (if (= ok 1) -9002 -9001)
        c)
      c)))
