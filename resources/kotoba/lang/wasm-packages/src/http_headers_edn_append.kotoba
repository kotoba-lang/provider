(ns kotoba.http.headers-edn-append
  (:export [headers_edn_append]))

;; T8.3 multi-header append + name uniqueness (ADR 0216). Composition on
;; http_header_edn / edn_quoted. Body is admission skeleton; Canonical WAT
;; owns dual scan, :name marker uniqueness (not true set/W4), and vector splice.
;; Full multi-export request/result still open.

(defn headers_edn_append
  [acc :string name :string value :string]
  :string
  (if (= (string-byte-length acc) 0)
    ""
    (if (string=? acc "[]")
      (string-concat "["
                     (string-concat name
                                    (string-concat value "]")))
      (string-concat acc
                     (string-concat " "
                                    (string-concat name
                                                   (string-concat value "]")))))))
