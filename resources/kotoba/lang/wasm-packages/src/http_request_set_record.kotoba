(ns kotoba.http.request-set-record
  ;; T8.3 ADR 0231: pure kit-shaped HTTP request guest record.
  ;; :headers is [:set [:ref :hdr/pair]] (kit :request shape) plus parallel
  ;; [:set :string] names for HTTP name uniqueness (typed-set-contains).
  ;; EDN encode is fixed-depth skeleton with headers-n (no set→vector fold —
  ;; typed-set has no iterator yet). Complements 0229 set-backed string EDN
  ;; and 0230 multi-ns Component reject package.
  ;; W4 recursive nested EDN ADT open; wasm-aot stays :partial.
  (:schemas {:hdr/pair [:record :hdr/pair
                        [[:name :string] [:value :string]]]
              :hdr/req [:record :hdr/req
                        [[:url :string]
                         [:headers [:set [:ref :hdr/pair]]]
                         [:names [:set :string]]
                         [:body :string]
                         [:timeout :i64]
                         [:code :i64]]]})
  (:export [http_req_begin
            http_req_add_header
            http_req_code
            http_req_count
            http_req_edn
            main]))

;; Sticky codes:
;;   0 ok
;;  -1 empty name
;;  -3 forbidden " or \ in url/body/name/value; bad begin
;;  -4 set full (32)
;;  -9 duplicate name (true name-set membership)

(defn- has-forbidden
  [s :string]
  :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n)
        0
        (let [c (string-code-point-at s i)]
          (if (= c 34)
            1
            (if (= c 92)
              1
              (recur (+ i 1)))))))))

(defn- digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn- nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn http_req_begin
  [url :string body :string timeout :i64]
  [:ref :hdr/req]
  (if (or (= (has-forbidden url) 1)
          (= (has-forbidden body) 1)
          (< timeout 0))
    (record-new [:ref :hdr/req]
                ""
                (typed-set-new [:set [:ref :hdr/pair]])
                (typed-set-new [:set :string])
                ""
                0
                -3)
    (record-new [:ref :hdr/req]
                url
                (typed-set-new [:set [:ref :hdr/pair]])
                (typed-set-new [:set :string])
                body
                timeout
                0)))

(defn http_req_code
  [st [:ref :hdr/req]]
  :i64
  (record-get st :code))

(defn http_req_count
  [st [:ref :hdr/req]]
  :i64
  (typed-set-count [:set [:ref :hdr/pair]] (record-get st :headers)))

(defn http_req_add_header
  [st [:ref :hdr/req] name :string value :string]
  [:ref :hdr/req]
  (let [url (record-get st :url)
        headers (record-get st :headers)
        names (record-get st :names)
        body (record-get st :body)
        timeout (record-get st :timeout)
        code (record-get st :code)]
    (if (not= code 0)
      (record-new [:ref :hdr/req] url headers names body timeout code)
      (if (= (string-length name) 0)
        (record-new [:ref :hdr/req] url headers names body timeout -1)
        (if (or (= (has-forbidden name) 1) (= (has-forbidden value) 1))
          (record-new [:ref :hdr/req] url headers names body timeout -3)
          (if (typed-set-contains [:set :string] names name)
            (record-new [:ref :hdr/req] url headers names body timeout -9)
            (if (>= (typed-set-count [:set [:ref :hdr/pair]] headers) 32)
              (record-new [:ref :hdr/req] url headers names body timeout -4)
              (let [h (record-new [:ref :hdr/pair] name value)
                    headers2 (typed-set-conj [:set [:ref :hdr/pair]] headers h)
                    names2 (typed-set-conj [:set :string] names name)]
                (record-new [:ref :hdr/req]
                            url headers2 names2 body timeout 0)))))))))

;; Fixed-depth EDN skeleton: headers-n from set count (no set iteration API).
(defn http_req_edn
  [st [:ref :hdr/req]]
  :string
  (let [code (record-get st :code)
        url (record-get st :url)
        body (record-get st :body)
        timeout (record-get st :timeout)
        n (typed-set-count [:set [:ref :hdr/pair]] (record-get st :headers))]
    (if (not= code 0)
      ""
      (string-concat "{:url \""
                     (string-concat url
                                    (string-concat "\" :headers-n "
                                                   (string-concat (nat-str n)
                                                                  (string-concat " :body \""
                                                                                 (string-concat body
                                                                                                (string-concat "\" :timeout-ms "
                                                                                                               (string-concat (nat-str timeout) "}")))))))))))

;; main → -9002: two unique headers, non-empty edn, then dup name → code -9, count 2
(defn main [] :i64
  (let [s0 (http_req_begin "https://x.test" "{}" 1000)
        s1 (http_req_add_header s0 "Host" "ex.com")
        s2 (http_req_add_header s1 "Accept" "*/*")
        e (http_req_edn s2)
        s3 (http_req_add_header s2 "Host" "other")
        c (http_req_code s3)
        n (http_req_count s2)]
    (if (= c -9)
      (if (= n 2)
        (if (> (string-length e) 0)
          -9002
          -9001)
        c)
      c)))
