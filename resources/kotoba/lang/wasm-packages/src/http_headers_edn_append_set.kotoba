(ns kotoba.http.headers-edn-append-set
  ;; T8.3 ADR 0224: pure reject-path headers EDN append with **true set**
  ;; uniqueness (set-in-record + [:set :string]), not WAT substring
  ;; `:name "…"` marker scan. Companion to ADR 0216 Canonical WAT path and
  ;; ADR 0223 name-set packing. No kotoba:typed host imports beyond typed ABI
  ;; for string/set (wasm32 + kotoba:typed). Component twin still open.
  ;; W4 recursive nested EDN ADT open; wasm-aot stays :partial.
  (:schemas {:hdr/edn-acc [:record :hdr/edn-acc
                           [[:edn :string]
                            [:names [:set :string]]
                            [:code :i64]]]})
  (:export [http_headers_edn_set_begin
            http_headers_edn_set_append
            http_headers_edn_set_edn
            http_headers_edn_set_code
            http_headers_edn_set_count
            main]))

;; Sticky codes:
;;   0 ok
;;  -1 empty name
;;  -3 name/value contains " or \  (reject-path dual scan)
;;  -4 set full (32 names)
;;  -9 duplicate name (true set membership)

(defn- has-forbidden
  [s :string]
  :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n)
        0
        (let [c (string-code-point-at s i)]
          (if (= c 34)
            1
            (if (= c 92)
              1
              (recur (+ i 1)))))))))

(defn- header-map
  [name :string value :string]
  :string
  (string-concat "{:name \""
                 (string-concat name
                                (string-concat "\" :value \""
                                               (string-concat value "\"}")))))

(defn http_headers_edn_set_begin
  []
  [:ref :hdr/edn-acc]
  (record-new [:ref :hdr/edn-acc]
              "[]"
              (typed-set-new [:set :string])
              0))

(defn http_headers_edn_set_edn
  [st [:ref :hdr/edn-acc]]
  :string
  (record-get st :edn))

(defn http_headers_edn_set_code
  [st [:ref :hdr/edn-acc]]
  :i64
  (record-get st :code))

(defn http_headers_edn_set_count
  [st [:ref :hdr/edn-acc]]
  :i64
  (typed-set-count [:set :string] (record-get st :names)))

(defn http_headers_edn_set_append
  [st [:ref :hdr/edn-acc] name :string value :string]
  [:ref :hdr/edn-acc]
  (let [edn (record-get st :edn)
        names (record-get st :names)
        code (record-get st :code)]
    (if (= code 0)
      (if (= (string-length name) 0)
        (record-new [:ref :hdr/edn-acc] edn names -1)
        (if (= (has-forbidden name) 1)
          (record-new [:ref :hdr/edn-acc] edn names -3)
          (if (= (has-forbidden value) 1)
            (record-new [:ref :hdr/edn-acc] edn names -3)
            (if (typed-set-contains [:set :string] names name)
              (record-new [:ref :hdr/edn-acc] edn names -9)
              (if (>= (typed-set-count [:set :string] names) 32)
                (record-new [:ref :hdr/edn-acc] edn names -4)
                (let [h (header-map name value)
                      names2 (typed-set-conj [:set :string] names name)
                      edn2 (if (string=? edn "[]")
                             (string-concat "[" (string-concat h "]"))
                             (string-concat
                              (string-substring edn 0 (- (string-length edn) 1))
                              (string-concat " " (string-concat h "]"))))]
                  (record-new [:ref :hdr/edn-acc] edn2 names2 0)))))))
      (record-new [:ref :hdr/edn-acc] edn names code))))

;; main → -9002: two unique headers then duplicate name → code -9, count was 2
(defn main [] :i64
  (let [s0 (http_headers_edn_set_begin)
        s1 (http_headers_edn_set_append s0 "Host" "ex.com")
        s2 (http_headers_edn_set_append s1 "Accept" "*/*")
        s3 (http_headers_edn_set_append s2 "Host" "other")
        c (http_headers_edn_set_code s3)
        n (http_headers_edn_set_count s2)
        e2 (http_headers_edn_set_edn s2)]
    (if (= c -9)
      (if (= n 2)
        (if (string=? e2 "[{:name \"Host\" :value \"ex.com\"} {:name \"Accept\" :value \"*/*\"}]")
          -9002
          -9001)
        c)
      c)))
