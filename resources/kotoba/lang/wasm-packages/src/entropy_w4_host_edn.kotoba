(ns kotoba.entropy.w4-host-edn
  ;; T8.3 ADR 0267: guest W4 entropy request encode + typed-cap-call wire id 23
  ;; (provider entropy/draw). Main pure → -2510. Host injects cap 23 for host_draw_edn.
  (:schemas {:edn/kv [:record :edn/kv [[:k :string] [:v :string]]]
             :edn/node [:variant :edn/node
                         [[:atom :string]
                          [:entry [:ref :edn/kv]]
                          [:pair [:vector [[:ref :edn/node]
                                           [:ref :edn/node]]]]]]})
  (:export [entropy_req_rec_kv_edn
            entropy_reply_hex_rec_kv_edn
            host_draw_edn
            main]))

(defn- has-forbidden [s :string] :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n) 0
        (let [c (string-code-point-at s i)]
          (if (= c 34) 1
            (if (= c 92) 1 (recur (+ i 1)))))))))

(defn- qstr [s :string] :string
  (string-concat (string-substring "\"x" 0 1)
                 (string-concat s (string-substring "\"x" 0 1))))

(defn- digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn- nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn- hex-char-ok [c :i64] :i64
  (if (or (and (>= c 48) (<= c 57))
          (and (>= c 97) (<= c 102)))
    1
    0))

(defn- hex-ok [hex :string] :i64
  (let [n (string-length hex)]
    (if (or (<= n 0) (> n 128) (not= n (* 2 (quot n 2)))) 0
      (if (= (has-forbidden hex) 1) 0
        (loop [i 0]
          (if (>= i n) 1
            (if (= (hex-char-ok (string-code-point-at hex i)) 0) 0
              (recur (+ i 1)))))))))

(defn- edn_entry [k :string v :string]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :edn/kv]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :edn/kv]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :entry
   (record-new [:record :edn/kv [[:k :string] [:v :string]]] k v)))

(defn- edn_pair
  [l [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :edn/kv]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   r [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :edn/kv]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :edn/kv]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :edn/kv]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :pair
   (hetero-vector [:vector [[:ref :edn/node] [:ref :edn/node]]] l r)))

(defn- edn_print
  [n [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :edn/kv]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (match-variant n
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :edn/kv]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
    (:atom s s)
    (:entry r
      (string-concat
       (record-get [:record :edn/kv [[:k :string] [:v :string]]] r :k)
       (string-concat " "
                      (record-get [:record :edn/kv [[:k :string] [:v :string]]] r :v))))
    (:pair p
      (string-concat
       (edn_print (hetero-vector-at [:vector [[:ref :edn/node] [:ref :edn/node]]] p 0))
       (string-concat " "
                      (edn_print (hetero-vector-at [:vector [[:ref :edn/node] [:ref :edn/node]]] p 1)))))))

(defn- brace-print
  [n [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :edn/kv]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (string-concat "{" (string-concat (edn_print n) "}")))

(defn entropy_req_rec_kv_edn [n :i64] :string
  (if (or (< n 1) (> n 64))
    ""
    (brace-print (edn_entry ":n" (nat-str n)))))

(defn entropy_reply_hex_rec_kv_edn [hex :string] :string
  (if (= (hex-ok hex) 0)
    ""
    (brace-print
     (edn_pair (edn_entry ":tag" ":hex")
               (edn_entry ":hex" (qstr hex))))))

(defn host_draw_edn [n :i64] :string
  (let [req (entropy_req_rec_kv_edn n)]
    (if (= (string-length req) 0)
      ""
      (typed-cap-call 23 :string :string req))))

(defn main [] :i64
  (let [req (entropy_req_rec_kv_edn 16)
        bad (entropy_req_rec_kv_edn 0)
        hex (entropy_reply_hex_rec_kv_edn "deadbeefcafebabe")
        good-req (if (string-contains? req ":n")
                   (if (string-contains? req "16") 1 0)
                   0)
        good-hex (if (string-contains? hex ":hex")
                   (if (string-contains? hex "deadbeef") 1 0)
                   0)
        ok-bad (if (= (string-length bad) 0) 1 0)]
    (if (= good-req 1)
      (if (= good-hex 1)
        (if (= ok-bad 1) -2510 -1)
        -1)
      -1)))
