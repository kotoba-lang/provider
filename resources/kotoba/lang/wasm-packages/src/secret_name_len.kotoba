(ns kotoba.secret.bounds
  (:export [secret_name_len_ok secret_value_len_ok]))

;; Pure length half of secret-v1 :limits {:name-bytes 128 :secret-bytes 8192}.
;; Char/path/wildcard scan remains hand WAT secret_name_ok (ptr,len) until
;; typed-string host packaging is the production path.
(defn secret_name_len_ok
  [name-len :i64]
  :i64
  (if (<= name-len 0)
    -1
    (if (> name-len 128)
      -2
      0)))

(defn secret_value_len_ok
  [secret-len :i64]
  :i64
  (if (< secret-len 0)
    -1
    (if (> secret-len 8192)
      -2
      0)))
