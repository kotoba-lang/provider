(ns kotoba.process.w4-host-edn
  ;; T8.3 ADR 0266: process W4 request encode + typed-cap-call wire 20
  (:schemas {:edn/kv [:record :edn/kv [[:k :string] [:v :string]]]
             :edn/node [:variant :edn/node
                         [[:atom :string]
                          [:entry [:ref :edn/kv]]
                          [:pair [:vector [[:ref :edn/node]
                                           [:ref :edn/node]]]]]]})
  (:export [process_req_rec_kv_edn host_spawn_edn main]))

(defn- digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn- nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn- edn_entry [k :string v :string]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :edn/kv]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :edn/kv]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :entry
   (record-new [:record :edn/kv [[:k :string] [:v :string]]] k v)))

(defn- edn_pair
  [l [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :edn/kv]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   r [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :edn/kv]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :edn/kv]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :edn/kv]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :pair
   (hetero-vector [:vector [[:ref :edn/node] [:ref :edn/node]]] l r)))

(defn- edn_print
  [n [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :edn/kv]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (match-variant n
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :edn/kv]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
    (:atom s s)
    (:entry r
      (string-concat
       (record-get [:record :edn/kv [[:k :string] [:v :string]]] r :k)
       (string-concat " "
                      (record-get [:record :edn/kv [[:k :string] [:v :string]]] r :v))))
    (:pair p
      (string-concat
       (edn_print (hetero-vector-at [:vector [[:ref :edn/node] [:ref :edn/node]]] p 0))
       (string-concat " "
                      (edn_print (hetero-vector-at [:vector [[:ref :edn/node] [:ref :edn/node]]] p 1)))))))

(defn process_req_rec_kv_edn
  [argv-edn :string max-stdout :i64 timeout-ms :i64]
  :string
  (if (or (= (string-length argv-edn) 0)
          (not (string-contains? argv-edn "["))
          (<= max-stdout 0)
          (> max-stdout 65536)
          (<= timeout-ms 0)
          (> timeout-ms 600000))
    ""
    (string-concat
     "{"
     (string-concat
      (edn_print
       (edn_pair (edn_entry ":argv" argv-edn)
                 (edn_pair (edn_entry ":max-stdout-bytes" (nat-str max-stdout))
                           (edn_entry ":timeout-ms" (nat-str timeout-ms)))))
      "}"))))

(defn host_spawn_edn
  [argv-edn :string max-stdout :i64 timeout-ms :i64]
  :string
  (let [req (process_req_rec_kv_edn argv-edn max-stdout timeout-ms)]
    (if (= (string-length req) 0)
      ""
      (typed-cap-call 20 :string :string req))))

(defn main [] :i64
  (let [req (process_req_rec_kv_edn "[\"echo\" \"hi\"]" 4096 5000)
        bad (process_req_rec_kv_edn "" 4096 5000)]
    (if (string-contains? req ":argv")
      (if (string-contains? req "echo")
        (if (= (string-length bad) 0) -2508 -1)
        -1)
      -1)))
