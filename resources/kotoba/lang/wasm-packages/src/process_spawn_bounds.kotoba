(ns kotoba.process.bounds
  (:export [process_spawn_bounds_ok]))

;; Pure process-v1 :limits checker (ADR 0172 compiler-AOT re-emit of ADR 0168 policy).
;; argc 1..32; max-stdout-bytes 1..65536; timeout-ms 1..600000.
(defn process_spawn_bounds_ok
  [argc :i64 max-out :i64 timeout-ms :i64]
  :i64
  (if (or (<= argc 0) (> argc 32))
    (if (<= argc 0) -1 -2)
    (if (or (<= max-out 0) (> max-out 65536))
      -3
      (if (or (<= timeout-ms 0) (> timeout-ms 600000))
        -4
        0))))
